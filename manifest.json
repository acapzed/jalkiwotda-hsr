{
  "manifest_version": 3,
  "name": "jalkiwotda-hsr",
  "version": "0.1.2",
  "description": "HoYoLAB 스타레일 캐릭터 정보를 기준표와 비교해 리포트를 만듭니다.",
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "action": {
    "default_title": "이잘키 스타레일 정오표",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://act.hoyolab.com/app/community-game-records-sea/rpg/*"
      ],
      "js": [
        "src/content/inject-hoyolab-response-hook.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected/hoyolab-response-hook.js",
        "src/assets/report-button.webp",
        "src/assets/icon-32.png",
        "src/assets/hp-icon.webp",
        "src/assets/atk-icon.webp",
        "src/assets/def-icon.webp",
        "src/assets/spd-icon.webp",
        "src/assets/crit-rate-icon.webp",
        "src/assets/crit-dmg-icon.webp",
        "src/assets/break-icon.webp",
        "src/assets/ehr-icon.webp",
        "src/assets/err-icon.webp",
        "src/assets/heal-icon.webp"
      ],
      "matches": [
        "https://act.hoyolab.com/*"
      ]
    }
  ]
}
